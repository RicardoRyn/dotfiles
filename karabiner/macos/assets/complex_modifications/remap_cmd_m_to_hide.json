{
  "title": "Remap Cmd+M to Hide",
  "rules": [
    {
      "description": "Disable Cmd+H, remap Cmd+M to Cmd+H",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": ["left_command"],
              "optional": ["right_command"]
            }
          },
          "to": []
        },
        {
            "type": "basic",
            "from": {
                "key_code": "h",
                "modifiers": {
                    "mandatory": ["command", "option"],
                    "optional": ["any"]
                }
            },
            "to": []
        },
        {
          "type": "basic",
          "from": {
            "key_code": "m",
            "modifiers": {
              "mandatory": ["command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "h",
              "modifiers": ["command"]
            }
          ]
        }
      ]
    }
  ]
}
